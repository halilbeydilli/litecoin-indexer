## ============================================
## Chain Indexer Configuration
## ============================================
## Copy this file to .env and adjust values.
## Works with ANY Bitcoin-based coin — just change the values below.

## ---- Coin Identity ----
COIN_NAME=litecoin
COIN_SYMBOL=LTC

## ---- Node RPC Connection ----
RPC_HOST=127.0.0.1
RPC_PORT=9332
RPC_USER=litecoinrpc
RPC_PASS=yourpassword
RPC_TIMEOUT=120000

## ---- MongoDB ----
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=ltc_index_database

## ---- API Server ----
API_PORT=3100
API_HOST=0.0.0.0

## ---- Indexer Tuning ----
START_HEIGHT=0
LOG_INTERVAL=100
REORG_SAFETY_DEPTH=200
MEMPOOL_POLL_INTERVAL=10000
BLOCKS_PER_TICK=10
WRITE_CONCERN=0
BATCH_SIZE=100
UTXO_CACHE_MAX=500000
